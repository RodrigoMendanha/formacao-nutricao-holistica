# ==========================================================================
# Google Sheets — destino dos leads do formulário "Quero outras informações"
# (mesmo padrão do projeto imersao-syatt: service account + Sheets API)
# --------------------------------------------------------------------------
# 1) Crie um Service Account no Google Cloud, habilite a Google Sheets API.
# 2) Compartilhe a planilha com o e-mail do service account (permissão de editor).
# 3) Copie o ID da planilha da URL: docs.google.com/spreadsheets/d/<ESTE_ID>/edit
# ==========================================================================

GOOGLE_SERVICE_ACCOUNT_EMAIL="conta-servico@seu-projeto.iam.gserviceaccount.com"
# A chave privada vem com \n literais — mantenha entre aspas.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID="cole_aqui_o_id_da_planilha"

# Nome da aba (worksheet) onde os leads serão gravados.
GOOGLE_SHEET_NAME="Formacao Nutricao Holistica"

claude --resume aa5c3b6d-9695-40de-91c0-60528ad16497